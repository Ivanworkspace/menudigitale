# ---------------------------------------------------------------------------
# Copia in .env.local (sviluppo) e nelle Environment Variables di Vercel.
# ---------------------------------------------------------------------------

# URL pubblico dell'applicazione (senza slash finale) e nome del tuo brand
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=MenuSaaS

# Firebase → Impostazioni progetto → Le tue app → Configurazione SDK (valori pubblici)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tuo-progetto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tuo-progetto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tuo-progetto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# SEGRETO — Firebase → Impostazioni progetto → Account di servizio → Genera nuova chiave privata.
# Incolla il JSON codificato in base64:  base64 -i chiave.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Chiave AES-256 per cifrare i link segreti dei locali e i segreti 2FA: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Protegge /api/cron/* (Vercel lo invia da solo): openssl rand -hex 24
CRON_SECRET=

# Backup giornaliero di Firestore (piano Blaze): bucket Cloud Storage, es. gs://tuo-progetto-backup
BACKUP_BUCKET=

# Email transazionali (https://resend.com). Senza chiave le email vengono solo scritte nel log.
RESEND_API_KEY=
EMAIL_FROM="MenuSaaS <noreply@tuodominio.it>"
# Ricevi in copia gli avvisi di scadenza dei clienti
ADMIN_NOTIFY_EMAIL=

# Traduzione automatica del menu (facoltativa, una delle due)
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# --- Solo sviluppo locale con gli emulatori Firebase (npm run emulators) ---
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Token fisso per il locale demo (min 40 caratteri), comodo per le presentazioni
# DEMO_ACCESS_TOKEN=
